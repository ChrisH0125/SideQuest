# Copy this file to .env.local and fill in real values there.
# .env.local is ignored by Git, so your key never gets committed.
# These are server-only settings. Never rename them with a NEXT_PUBLIC_ prefix,
# because that would send them to every visitor's browser.

# Required for real Pip replies; keep the key server-only.
# Choose a Gemini text model available to your project.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TEXT_FALLBACK_MODEL=gemini-3.5-flash-lite
# Reserved for a future direct Gemini Live integration. Vapi handles voice now.
GEMINI_LIVE_MODEL=gemini-3.8-live

# Browser-safe Vapi public key (never use a private Vapi key here).
# Restrict the public key to your assistant and app origins in Vapi.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
