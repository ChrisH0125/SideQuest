# Copy this file to .env.local and fill in real values there.
# .env.local is ignored by Git, so your key never gets committed.
# These are server-only settings. Never rename them with a NEXT_PUBLIC_ prefix,
# because that would send them to every visitor's browser.

# Required for real Pip replies. Without these, Pip answers with "ai_unavailable".
GEMINI_API_KEY=
# Model ID for text coaching. Ask the AI teammate which model the team's account uses.
GEMINI_TEXT_MODEL=
GEMINI_TEXT_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional. Not used by the code yet; reserved for live voice.
GEMINI_LIVE_MODEL=
